  messagingSenderId: "933965264781",
  appId: "1:933965264781:web:f2fed54473db09b9546fc4",
  measurementId: "G-D190WZEMRH",
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const database = getDatabase(app);
const googleProvider = new GoogleAuthProvider();

const form = document.querySelector("#signupForm");
const googleButton = document.querySelector("#googleButton");
const loading = document.querySelector("#loading");
const formMessage = document.querySelector("#formMessage");
const nameInput = document.querySelector("#name");
const emailInput = document.querySelector("#email");
const passwordInput = document.querySelector("#password");
const confirmPasswordInput = document.querySelector("#confirmPassword");
const submitButton = form.querySelector('button[type="submit"]');

function setLoading(isLoading, message = "Creating your account...") {
  loading.querySelector(".loading-card span:last-child").textContent = message;
  loading.hidden = !isLoading;
  submitButton.disabled = isLoading;
  googleButton.disabled = isLoading;
}

function showMessage(message = "") {
  formMessage.textContent = message;
}

function firebaseErrorMessage(error) {
  const knownMessages = {
    "auth/email-already-in-use": "An account with this email already exists.",
    "auth/invalid-email": "Please enter a valid email address.",
    "auth/weak-password": "Choose a stronger password with at least 6 characters.",
    "auth/popup-closed-by-user": "Google sign-in was cancelled.",
    "auth/popup-blocked": "Your browser blocked the Google sign-in popup.",
  };

  return knownMessages[error.code] || error.message || "Something went wrong. Please try again.";
}

function clearInvalidStates() {
  [nameInput, emailInput, passwordInput, confirmPasswordInput].forEach((input) => {
    input.removeAttribute("aria-invalid");
  });
}

function validateForm() {
  clearInvalidStates();
  const name = nameInput.value.trim();
  const email = emailInput.value.trim();
  const password = passwordInput.value;
  const confirmPassword = confirmPasswordInput.value;

  if (!name) {
    nameInput.setAttribute("aria-invalid", "true");
    return "Please enter your full name.";
  }
  if (!email || !emailInput.validity.valid) {
    emailInput.setAttribute("aria-invalid", "true");
    return "Please enter a valid email address.";
  }
  if (password.length < 6) {
    passwordInput.setAttribute("aria-invalid", "true");
    return "Your password must be at least 6 characters.";
  }
  if (password !== confirmPassword) {
    confirmPasswordInput.setAttribute("aria-invalid", "true");
    return "Passwords do not match.";
  }

  return "";
}

onAuthStateChanged(auth, (user) => {
  if (user) {
    window.location.replace("./index.html");
  }
});

form.addEventListener("submit", async (event) => {
  event.preventDefault();
  showMessage();

  const validationMessage = validateForm();
  if (validationMessage) {
    showMessage(validationMessage);
    return;
  }

  const name = nameInput.value.trim();
  const email = emailInput.value.trim();
  setLoading(true);

  try {
    const credential = await createUserWithEmailAndPassword(auth, email, passwordInput.value);
    await updateProfile(credential.user, { displayName: name });
    await set(ref(database, `users/${credential.user.uid}`), { name, email });
    window.location.replace("./index.html");
  } catch (error) {
    setLoading(false);
    showMessage(firebaseErrorMessage(error));
  }
});

googleButton.addEventListener("click", async () => {
  showMessage();
  setLoading(true, "Connecting to Google...");

  try {
    const result = await signInWithPopup(auth, googleProvider);
    await set(ref(database, `users/${result.user.uid}`), {
      name: result.user.displayName || "",
      email: result.user.email || "",
    });
    window.location.replace("./index.html");
  } catch (error) {
    setLoading(false);
    showMessage(firebaseErrorMessage(error));
  }
});
