<script type="module">

import { initializeApp }
from "https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";

import {
getDatabase,
ref,
query,
orderByChild,
equalTo,
onValue
}
from "https://www.gstatic.com/firebasejs/12.0.0/firebase-database.js";

import {
    getAuth,
    onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/12.0.0/firebase-auth.js";

const firebaseConfig={

apiKey:"AIzaSyAFXjp4X7M7MaraRuhFHiqooFLYhcc3f_A",
authDomain:"doubtnest-0.firebaseapp.com",
databaseURL:"https://doubtnest-0-default-rtdb.firebaseio.com",
projectId:"doubtnest-0",
storageBucket:"doubtnest-0.firebasestorage.app",
messagingSenderId:"933965264781",
appId:"1:933965264781:web:f2fed54473db09b9546fc4"

};


const app=initializeApp(firebaseConfig);

const db=getDatabase(app);
const auth=getAuth(app);



const latestQuery=query(
ref(db,"doubts"),
orderByChild("status"),
equalTo("answered")
);



onValue(latestQuery,(snapshot)=>{


let doubts=[];


snapshot.forEach((child)=>{

let d=child.val();

d.id=child.key;

doubts.push(d);

});


// latest first
doubts.sort((a,b)=>b.time-a.time);


// only two
doubts=doubts.slice(0,2);



let html="";



doubts.forEach((d)=>{


html+=`

<article class="post-card">


<div class="post-image">

<img src="${d.answerImage || d.image || 'assets/images/question.jpg'}"
alt="Doubt Answer">

</div>



<div class="post-content">


<span class="post-category">

${d.subject || "General"}

</span>



<h3 class="post-title">

<a href="/p/latest-doubt-answers.html">

${d.question}

</a>

</h3>



<p class="post-description">

${d.answer ? d.answer.substring(0,120)+"..." : "Answer available"}

</p>



<div class="post-meta">

Answered ${d.time ? new Date(d.time).toLocaleDateString() : ""}

</div>



</div>


</article>

`;

});



document.getElementById("latestDoubts").innerHTML =
html || "<p>No answered doubts yet.</p>";



});

// Show a notification indicator for the signed-in student.
let popupShown = false;

window.openNotifications = function () {
    const popup = document.getElementById("newNotificationPopup");
    if (popup) popup.style.display = "none";
    popupShown = false;
    location.href = "student-notification-page.html";
};

function showNotificationPopup() {
    if (popupShown) return;
    popupShown = true;
    const popup = document.getElementById("newNotificationPopup");
    if (popup) popup.style.display = "block";
}

onAuthStateChanged(auth, (user) => {
    if (!user || !user.email) return;

    const emailKey = user.email.replace(/\./g, "_");
    const notificationRef = ref(db, "notifications/" + emailKey);

    onValue(notificationRef, (snapshot) => {
        let unread = false;

        snapshot.forEach((child) => {
            const data = child.val();
            if (data && data.read === false) unread = true;
        });

        const dot = document.getElementById("notificationDot");
        if (dot) dot.style.display = unread ? "inline-block" : "none";

        const popup = document.getElementById("newNotificationPopup");
        if (unread) {
            showNotificationPopup();
        } else {
            popupShown = false;
            if (popup) popup.style.display = "none";
        }
    });
});


</script>







